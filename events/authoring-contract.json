  "schema": "Gamblee Event Research JSON",
  "schema_version": "1.0",
  "compatible_schema_versions": [
    "1.0"
  ],
  "purpose": "Research scheduled competitive or playable gambling events and map verified facts into the Gamblee Event CPT while preserving the existing listing-card layout.",
  "routing": {
    "event": "Scheduled competitive/playable campaigns: slot or poker tournaments, freerolls, leaderboards, casino races and scheduled bingo rooms/sessions. A qualifying deposit does not move these out of Events.",
    "promotion": "Prize draws, raffles, giveaways, sweepstakes, random-winner competitions, missions/challenges, cashback, loyalty mechanics, prize wheels and mystery boxes remain Promotions even when time-limited or deposit-gated.",
    "bonus": "Direct deterministic signup/new-customer rewards, or direct deterministic rewards whose claim requires a fresh upfront deposit, remain Bonuses unless an Event or Promotion override applies."
  },
  "principles": [
    "One event object represents one discrete scheduled campaign or recurring event series.",
    "Respect the existing Event listing card: headline prize pool/jackpot, entry badge, no more than three compact info rows, countdown/status and CTA.",
    "card.rows contains the three most useful listing facts only. Put deeper qualification and scoring mechanics in structured fields and terms.",
    "Use event_categories for the event mechanic and vertical separately for casino, betting, bingo or poker.",
    "Markets and currencies are independent.",
    "Do not use Events for prize draws, giveaways or other random-winner campaigns merely because they have dates.",
    "Keep an established event_key stable across revisions. event_key is the idempotency key.",
    "Return one event_reconciliation row for every existing Event supplied to research: confirmed, ended or not_found. not_found never retires anything.",
    "schema_gaps is reserved for Event-classified mechanics that cannot be represented faithfully."
  ],
