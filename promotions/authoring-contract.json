  "editorial_content_requirements": {
    "title": {
      "purpose": "Write a useful search/editorial title, not merely the operator campaign label.",
      "guidance": [
        "For brand-only promotions, use the deterministic pattern <Brand> <Market label> <Vertical> Offer • <Reward or concrete mechanic>.",
        "When provider_group is set, omit the brand name and use a brand-neutral campaign title such as Weekly Cashback • 5% Back on Eligible Slots Net Spend. Add a market label only when the campaign itself is market-specific.",
        "Use concise editorial market labels such as GB=UK, CA=Canada, CA-AB=Alberta, IE=Ireland, NZ=New Zealand and ZA=South Africa.",
        "If the title would exceed 65 characters, omit <Vertical> first: <Brand> <Market label> Offer • <Reward or concrete mechanic>.",
        "A specific mechanic noun such as Cashback, Tournament or Leaderboard may replace Offer when clearer.",
        "Do not truncate verified reward/mechanic text merely to retain the vertical label, and do not add unsupported superlatives or clickbait."
      ]
    },
    "content_html": {
      "target_word_range": "300-700 words when evidence supports it; shorter only for genuinely simple promotions.",
      "minimum_structure": [
        "Open with a concrete summary stating what the promotion is, who it is for when known, the main reward and the core qualification mechanic.",
        "Use at least two useful H2 sections after the introduction.",
        "Include at least one factual list (ordered steps or bullet-point facts/conditions).",
        "Explain the qualification path step by step when the mechanic has multiple stages.",
        "Surface exact verified amounts, percentages, odds, legs, dates, expiry periods, caps, wagering requirements and limits wherever known.",
        "Explain reward crediting and what happens after qualification.",
        "Include eligibility and material exclusions/restrictions when known.",
        "For tiered, recurring, leaderboard, prize-draw or variable-reward promotions, explain the actual tier/scoring/draw/reset mechanic rather than summarising it vaguely.",
        "Derived arithmetic may be included only when it follows directly from verified terms and the calculation is transparent.",
        "Avoid duplicating the same paragraph or padding with generic gambling advice.",
        "Write only for the end reader. Never explain Gamblee research scope, market mapping, schema choices, taxonomy choices, importer behaviour, why a structured field is null, or why a market/date was not inferred.",
        "If a genuinely useful player-facing fact is unstated, say so neutrally only when relevant (for example, \"No expiry date is stated\"). Do not explain how the omission affected internal data modelling.",
        "Keep research uncertainty and mapping rationale in evidence.notes, not content_html or terms.summary."
      ],
      "recommended_sections": [
        "How the promotion works",
        "Promotion facts or What you can win",
        "Who can take part (when eligibility is material)",
        "Important conditions"
      ]
    }
  },
  "network_relationship": {
    "provider_group": "Optional canonical slug from provider_groups (owner taxonomy), for example progress-play. Use only when the same campaign is distributed across that provider/operator group.",
    "excluded_casinos": "Optional list of WordPress Casino Review IDs or canonical post slugs that are known exceptions within provider_group. Empty for no known exceptions. Requires provider_group.",
    "direct_brand_rule": "Brand-only promotions may be updated only by their direct/source brand. A canonical provider-group promotion may be updated by research for any covered brand when promotion_id, promotion_key and provider_group reconcile; the importer preserves the original direct/source casino."
  },
